# Copiá este archivo como .env.local y completá los valores.
# .env.local NUNCA se sube al repositorio (el repo es público).
#
# Dónde están: Supabase → el proyecto → Project Settings → API Keys
# (URL del proyecto y la "publishable key", que empieza con sb_publishable_).
# Nunca uses acá la "secret key" ni la "service_role".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
